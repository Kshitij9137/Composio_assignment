# Copy this file to .env and fill in your real keys.
# Never commit the real .env file -- it's already in .gitignore.

# From composio.dev dashboard, after you sign up (Settings > API Keys)
COMPOSIO_API_KEY=

# From console.anthropic.com -- used by the agent to reason over search
# results and produce the structured JSON matching schema.py
ANTHROPIC_API_KEY= 
